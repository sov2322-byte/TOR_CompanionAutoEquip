<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent"
            HeightSizePolicy="StretchToParent"
            DoNotAcceptEvents="true">
      <Children>
        <ListPanel WidthSizePolicy="Fixed"
                   HeightSizePolicy="CoverChildren"
                   SuggestedWidth="315"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   MarginLeft="-300"
                   MarginBottom="82"
                   LayoutImp.LayoutMethod="VerticalBottomToTop">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="Fixed"
                        SuggestedHeight="24"
                        MarginTop="4"
                        Text="@StatusText"
                        Brush="ButtonBrush1.Text"
                        DoNotAcceptEvents="true" />

            <ButtonWidget Id="MageAutoEquipButton"
                          WidthSizePolicy="StretchToParent"
                          HeightSizePolicy="Fixed"
                          SuggestedHeight="42"
                          MarginTop="6"
                          Brush="ButtonBrush1"
                          Command.Click="ExecuteMageDefense"
                          IsEnabled="true"
                          AcceptEvents="true"
                          DoNotPassEventsToChildren="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            Text="@MageDefenseText"
                            Brush="ButtonBrush1.Text"
                            DoNotAcceptEvents="true"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
              </Children>
            </ButtonWidget>

            <ButtonWidget Id="MaxDefenseAutoEquipButton"
                          WidthSizePolicy="StretchToParent"
                          HeightSizePolicy="Fixed"
                          SuggestedHeight="42"
                          Brush="ButtonBrush1"
                          Command.Click="ExecuteMaxDefense"
                          IsEnabled="true"
                          AcceptEvents="true"
                          DoNotPassEventsToChildren="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            Text="@MaxDefenseText"
                            Brush="ButtonBrush1.Text"
                            DoNotAcceptEvents="true"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
              </Children>
            </ButtonWidget>
          </Children>
        </ListPanel>
      </Children>
    </Widget>
  </Window>
</Prefab>
